# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google Cloud service account keys — never commit these
/service account/
*.iam.gserviceaccount.com*.json

# vercel
.vercel

# supabase CLI local state
supabase/.temp

# raw PMS data extract — real worker PII (salaries, passport numbers, DOB,
# hostel addresses); this repo is public, so this stays local-only
scripts/plantpro-migration/migration_data.json

# typescript
*.tsbuildinfo
next-env.d.ts
